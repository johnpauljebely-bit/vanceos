# Discord OAuth app (same Discord application as the delta-city-dispatch bot)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3002/api/auth/callback/discord
DISCORD_GUILD_ID=1535866581316276256

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002

# Database. As of 2026-08-10 this points at a real shared Postgres instance
# (Homebrew postgresql@16, `brew services start postgresql@16`, db "delta_city")
# that both this app and the delta-city-dispatch bot use — see COORDINATION.md.
# Leave DATABASE_URL unset to fall back to an embedded, zero-install local
# PGlite dev DB (stored at ./.pglite) instead — same schema/query code either
# way. If you do fall back to PGlite, use `npm run dev:local-pglite` (not
# plain `npm run dev`) — PGlite isn't safe for the concurrent multi-process
# access Turbopack's dev server does, and that script routes around it.
DATABASE_URL=postgres://delta_city_app@localhost:5432/delta_city
PGLITE_DATA_DIR=./.pglite
PGLITE_SOCKET_PORT=5433

# Shared secret for calling the bot's future POST /internal/announce endpoint
# (BOT_SIDE_INSTRUCTIONS.md #4). Must match INTERNAL_API_SECRET in the bot's
# own .env once that endpoint exists.
BOT_INTERNAL_API_SECRET=
BOT_INTERNAL_API_URL=http://localhost:3000/internal/announce

# Opposite direction: the bot calling INTO the CAD (POST /api/calls/[id]/auto-dispatch).
# Bot session must use the exact same value in its own .env.
CAD_INTERNAL_API_SECRET=
